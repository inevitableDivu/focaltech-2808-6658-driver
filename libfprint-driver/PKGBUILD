# Maintainer: Divyansh Pandey <pandeydivyansh070501@gmail.com>
pkgname=libfprint-focaltech-6658
pkgver=1.94.100
pkgrel=1
pkgdesc="Library for fingerprint readers with FocalTech FW9366 (2808:6658) driver support"
arch=('x86_64')
url="https://fprint.freedesktop.org/"
license=('LGPL-2.1-or-later')
depends=(
  'glib2'
  'glibc'
  'libgcc'
  'libgudev'
  'libgusb'
  'openssl'
  'pixman'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'glib2-devel'
  'gobject-introspection'
  'cairo'
)
provides=('libfprint' 'libfprint-2.so')
conflicts=('libfprint')
source=(
  "git+https://gitlab.freedesktop.org/libfprint/libfprint.git#tag=v$pkgver"
  "focaltech_6658.c"
  "meson.patch"
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
)

prepare() {
  cd libfprint
  cp "$srcdir/focaltech_6658.c" libfprint/drivers/focaltech_6658.c
  patch -Np1 -i "$srcdir/meson.patch"
}

build() {
  arch-meson libfprint build \
    -D doc=false \
    -D installed-tests=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
